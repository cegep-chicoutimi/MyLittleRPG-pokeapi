@model IEnumerable<lab_01_e04_pokeapi_api.Models.Utilisateur>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MotDePasse)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pseudo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateInscription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Personnages)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.MotDePasse)
            </td>
            <td>
                @Html.DisplayFor(model => item.Pseudo)
            </td>
            <td>
                @Html.DisplayFor(model => item.DateInscription)
            </td>
            <td>
                @Html.DisplayFor(model => item.Personnages)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdUtilisateur">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdUtilisateur">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdUtilisateur">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
